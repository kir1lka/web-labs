@webLabsNeedsSlash path /web-labs /web-labs/lab1 /web-labs/lab2 /web-labs/lab3 /web-labs/lab4 /web-labs/lab5 /web-labs/lab6 /web-labs/lab1/letter /web-labs/lab1/planets
redir @webLabsNeedsSlash {http.request.uri.path}/ 308

handle_path /web-labs/* {
	route {
		@webLabsPrivate path_regexp webLabsPrivate (?i)(^|/)[.]|[.](docx|pdf|zip|py|md|ya?ml|json|toml|ini|env|log|bak|tmp|ps1|sh|bat|cmd|exe|dll|key|pem|crt)$
		respond @webLabsPrivate 404

		@webLabsUnsupported {
			not path_regexp webLabsPublic (?i)(/|[.](html|css|js|png|jpe?g|gif|webp|svg|ico|xml|dtd|xsd))$
		}
		respond @webLabsUnsupported 404

		root * /repo
		file_server
	}
}
